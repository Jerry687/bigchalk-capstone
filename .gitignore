*.xlsx
*.xls
Anonymized Data for Project.xlsx
# Presentation slides / decks (client kickoff + team decks — NDA)
*.pptx
*.ppt
*.key
# Meeting transcripts (NDA)
*_otter_ai_transcript.txt
*transcript*.txt
# All local-only NDA material (decks, transcripts, raw exports)
local/

# ----- Agent / AI-tooling development files (not part of the deliverable) -----
.agents/
.codex/
.claude/
.cursor/
AGENTS.md
CODEX_HANDOFF.md
*.inspect.ndjson

# ----- Python -----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ----- OS / editor -----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ----- scratch / logs / transient artifacts -----
*.log
debug.txt
out.log
result.txt
*.uploadtmp
*.bak
